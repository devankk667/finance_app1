# Copy these values into your process environment; this template is not loaded automatically.
# Generate a unique random signing secret of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./finance.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Required to send/check real phone OTPs with Twilio Verify.
TWILIO_ACCOUNT_SID=AC_replace_with_your_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_replace_with_your_verify_service_sid
